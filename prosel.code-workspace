{
    "folders": [
        {"name": "ProSel",                               "path": "."},
    ],
    "settings": {
        "editor.formatOnPaste": true,
        "editor.formatOnSave": true,
        "editor.fontFamily": "Meslo LG S for Powerline, Consolas, 'Courier New', monospace",

        "[python]": {"editor.defaultFormatter": "ms-python.black-formatter"},
        "[django-html]": {"editor.defaultFormatter": "monosans.djlint"},
        "[json]": {"editor.defaultFormatter": "vscode.json-language-features"},
        "[html]": {"editor.defaultFormatter": "vscode.html-language-features"},
        "[dockerfile]": {"editor.defaultFormatter": "ms-azuretools.vscode-docker"},
        "github.copilot.chat.commitMessageGeneration.instructions": [
            {"text": "Gere mensagens de commit em português, use formato conventional detalhado commits: tipo(escopo): descrição."},
            {"text": "Inclua impacto das mudanças, arquivos afetados e motivo. Mantenha imperativo."}
        ]
    }
}
