class Color:
    ENDC = "\033[0m"

    def r(text: str) -> str:
        """Returns a *red* string"""
        return f"\033[91m{text}{Color.ENDC}"

    def b(text: str) -> str:
        """Returns a *blue* string"""
        return f"\033[94m{text}{Color.ENDC}"

    def g(text: str) -> str:
        """Returns a *green* string"""
        return f"\033[92m{text}{Color.ENDC}"

    def c(text: str) -> str:
        """Returns a *cyan* string"""
        return f"\033[96m{text}{Color.ENDC}"

    def m(text: str) -> str:
        """Returns a *magenta* string"""
        return f"\033[95m{text}{Color.ENDC}"

    def y(text: str) -> str:
        """Returns a *yellow* string"""
        return f"\033[93m{text}{Color.ENDC}"

    def s(text: str) -> str:
        """Returns a *strong* string"""
        return f"\033[1m{text}{Color.ENDC}"

    def u(text: str) -> str:
        """Returns a *underlined* string"""
        return f"\033[4m{text}{Color.ENDC}"


class Commands:

    def __init__(self) -> None:
        self._services = []
        self._repositories = []
        self._commands = {}
        self._scopes = {}
        self._descriptions = {}
        self._command_name = sys.argv[1] if len(sys.argv) > 1 else "help"
        self._scope_name = sys.argv[2] if len(sys.argv) >= 3 else "env"
        self._service_name = self._scope_name if self._scope_name != "env" else ""

        self.__read_envs()
        self.__read_compose()
        self.__load_commands()
        self.__validate()

    def __read_envs(self):
        with open(f"{WORKSPACE_DIR}/.env", "r") as f:
            for l in f.readlines():
                if l.startswith("#"):
                    continue
                if l.strip() == "":
                    continue
                varname = l.split("=", 2)[0]
                varval = l.split("=", 2)[1][:-1]
                if varname == "COMPOSE_PROJECT_NAME" and varval != PROJECT_NAME:
                    raise Exception(
                        f"No arquivo .env está como {l}, mas devia ser {varname}={PROJECT_NAME}"
                    )
                os.environ[varname] = varval

    def __read_compose(self):
        def is_service(line):
            result = re.search("^  (\\w*):$", line)
            if result is not None:
                if len(result.groups()) == 1 and result.group(1) != "default":
                    return result.group(1)

        def is_image(line):
            result = re.search("^(    image: )(.*)$", line)
            if result is not None:
                if len(result.groups()) > 0:
                    image = result.group(2)
                    return image.split("/")[0] if image.count("/") > 1 else ""

        f = os.popen("docker compose config")
        self._services = []
        self._repositories = []
        for line in f.read().splitlines():
            if is_service(line):
                self._services.append(is_service(line))
            if is_image(line):
                self._repositories.append(is_image(line))
        self._repositories.append("")
        self._repositories = set(self._repositories)

    def __load_commands(self):
        for k, v in inspect.getmembers(self, inspect.ismethod):
            if not v.__doc__:
                continue

            match = re.search(r"^(.*)(Aplica-se a: )(.*)$", v.__doc__)
            if match is None:
                continue

            self._commands[k] = v
            self._scopes[k] = []
            self._descriptions[k] = "Sem descrição"
            scopes_names = match.group(3)
            scopes_names = scopes_names.replace(
                "$services_names$", ",".join(self._services)
            )
            scopes_names = scopes_names.replace(
                "$restore_dirs$",
                ",".join(self.__prefixed_envs("RESTORE_DIR_").keys()),
            )
            scopes_names = scopes_names.replace(
                "$download_files$",
                ",".join(self.__prefixed_envs("DOWNLOAD_FILE").keys()),
            )
            self._scopes[k] = scopes_names.split(",")
            self._descriptions[k] = match.group(1) + match.group(2)

    def __validate(self):
        if len(sys.argv) == 1:
            self.help()

        if self._command_name not in self._commands:
            print(
                f"{Color.g('docker compose')} {Color.b(self._command_name)} {Color.m(' '.join(sys.argv[2:]))}"
            )
            self.__execute("docker", "compose", *sys.argv[1:])
            exit()

        if self._scope_name is None:
            print(
                f"Para o comando {Color.m(self._command_name)}, os serviços disponíveis são: "
                + Color.c(", ".join(self._scopes[self._command_name]))
            )
            exit()

    def __service_is_running(self, service_name):
        f = os.popen("docker container ps")
        for line in f.read().splitlines():
            if re.match(f".*{PROJECT_NAME}-{service_name}-1.*", line):
                return True
        return False

    def __service_is_healthy(self, service_name):
        f = os.popen("docker container ps")
        for line in f.read().splitlines():
            if re.match(f".*{PROJECT_NAME}-{service_name}-1.*", line) and re.match(
                f".*healthy.*", line
            ):
                return True
        return False

    def __execute(self, executable_file, *args):
        print(
            Color.g("Executando: "),
            Color.b(f"{executable_file} {' '.join(args)}"),
        )
        p = subprocess.Popen(
            executable_file + " " + " ".join(args),
            stdin=sys.stdin,
            stdout=sys.stdout,
            stderr=sys.stdout,
            shell=True,
            cwd=WORKSPACE_DIR,
        )
        p.wait()

    def __writeShellFile(self, filename):
        if os.path.exists(f"{HOME}/{filename}"):
            with open(f"{HOME}/{filename}", "r") as f:
                if f"{PROJECT_NAME}_workspace" not in f.read():
                    self.__execute(f"echo 'PATH=$PATH:{WORKSPACE_DIR}' >> ~/{filename}")
                    print("Lembre-se de executar o comando abaixo:")
                    print(Color.g(f"source ~/{filename}"), "\n")

    def __prefixed_envs(self, prefix):
        return {
            k[len(prefix) :].lower(): v
            for k, v in os.environ.items()
            if k.startswith(prefix)
        }

    @property
    def _verb(self):
        return "exec" if self.__service_is_running(self._service_name) else "run --rm"

    @property
    def command_method(self):
        # arg_command = sys.argv[1] if 1 in sys.argv else ""
        for k, v in self._commands.items():
            if k == self._command_name:
                return v
        return None

