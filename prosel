    def relaunch(self):
        """Para e depois inicia ambiente ou o serviço especificado, não faz lock do CLI. Aplica-se a: $services_names$,env"""
        self.__execute(f"docker compose down {self._service_name}")
        # self.__execute(f"docker compose pull {self._service_name}")
        self.__execute(f"docker compose up -d {self._service_name}")

    def launch(self):
        """Mostra o status ambiente ou o serviço especificado. Aplica-se a: $services_names$,env"""
        self.relaunch()
        self.__execute(f"docker compose logs -f {self._service_name}")

    def exec(self):
        """Executa um comando em um serviço que já esteja em execução. Aplica-se a: $services_names$,env"""
        self.__execute(
            f"docker compose {self._verb} {self._service_name} ", *sys.argv[3:]
        )

