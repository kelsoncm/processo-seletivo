                    if "|" in url:
                        url, branch_name = url.split("|", 1)
                        branch_arg = f"-b {branch_name}"
                    else:
                        branch_name = 'default'
                        branch_arg = f""
                    print(f"Clonando em {Color.c(proj_dir)} da url {Color.y(url)}, branch {Color.m(branch_name)}")
                    self.__execute(f"git clone {branch_arg} {url} {proj_dir}")

        def write_hosts():
            hosts_str = self.__prefixed_envs("HOSTS")
            if "" not in hosts_str:
                return
            hosts = self.__prefixed_envs("HOSTS")[""].split(":", 1)
            hosts_name = hosts[0]
            hosts_value = hosts[1]
            with open("/etc/hosts", "r") as f:
                if hosts_value not in f.read():
                    print(f"Adicionando este {hosts_value} em /etc/hosts:")
                    nls = "#" * 70
                    new_hosts = f"\n{nls}\n## {hosts_name}\n{nls}\n{hosts_value}\n"
                    self.__execute(f"echo '{new_hosts}' | sudo tee -a /etc/hosts")

        def mk_volumes():
            for mkvols in self.__prefixed_envs("MK_VOLUMES").items():
                for mkvol in mkvols[1].split(","):
                    vol = f"{VOLUMES_DIR}/{mkvol}"
                    os.makedirs(vol, exist_ok=True)
                    self.__execute(f"sudo chmod -R 777 {vol}")

        def write_profiles():
            self.__writeShellFile(".bashrc")
            self.__writeShellFile(".zshrc")

        self.__execute(f"docker compose down {self._service_name}")
        clone_projects()
        write_hosts()
        mk_volumes()

        write_profiles()

    def deploy(self):
        """Pára todo o ambiente, inicia os serviços de background (db e cache), constrói as imagens, iniciar os serviços web em background e acompanha o log do ambiente. Aplica-se a: env"""
        self.setup()
        self.__execute(f"docker compose up -d")

    def undeploy(self):
        """Pára todo o ambiente e remove a pasta ../volumes/prosel. Aplica-se a: $services_names$,env"""

        if self._scope_name == "env":
            self.__execute(f"docker compose down {self._service_name}")
        else:
            self.__execute(f"docker compose down {self._service_name}")
            self.__execute(f"ava exec db dropdb -U postgres {self._service_name}")
            self.__execute(f"ava exec db createdb -U postgres {self._service_name}")

        self.__execute(f"sudo rm -rf {VOLUMES_DIR}/{self._service_name}")
        for mkvols in self.__prefixed_envs("MK_VOLUMES").items():
            for mkvol in mkvols[1].split(","):
                vol = f"{VOLUMES_DIR}/{mkvol}"
                os.makedirs(vol, exist_ok=True)
                self.__execute(f"sudo chmod -R 777 {vol}")

    def git(self):
        """Executa o comando git em todos os repositórios git. Aplica-se a: env"""
        git_arguments = " ".join(sys.argv[2:]) if len(sys.argv) > 2 else "status"
        self.__execute(f"cd {WORKSPACE_DIR};git {git_arguments}")
        for proj, url in self.__prefixed_envs("GITCLONE_").items():
            proj_dir = f"{PROJECT_DIR}/{proj.replace('__', '/')}"
            if os.path.exists(proj_dir):
                self.__execute(f"cd {proj_dir};git {git_arguments}")
            else:
                print(f"O projeto {proj_dir} NÃO foi clonado ainda.")

    def cli(self):
        """Executa a CLI padrão de um serviço, pode ser php, shell_plus, psql ou redis-cli, caso contrário será bash usará exec se já estiver em execução, run caso contrário. Aplica-se a: $services_names$"""
        cmd = self.__prefixed_envs("CLI_").get(self._service_name, "bash")
        self.__execute(
            f"docker compose {self._verb} {self._service_name} {cmd} ", *sys.argv[3:]
        )

